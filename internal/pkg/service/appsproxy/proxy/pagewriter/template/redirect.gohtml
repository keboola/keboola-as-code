<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/_proxy/assets/favicon.ico">

    <title>Sign in</title>
    <meta http-equiv="refresh" content="0;URL='{{.URL}}'">

    <link rel="stylesheet" href="/_proxy/assets/styles.css">
</head>
<body class="s-working">
<div class="shell">
<div class="mark mark--sm"><svg viewBox="0 0 240 96" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="sheenGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0"  stop-color="var(--sheen)" stop-opacity="0"/>
        <stop offset=".5" stop-color="var(--sheen)" stop-opacity="1"/>
        <stop offset="1"  stop-color="var(--sheen)" stop-opacity="0"/>
      </linearGradient>
      <clipPath id="sheenClip">
        <rect x="26" y="38" width="30" height="6" rx="3"/>
        <rect x="26" y="50" width="20" height="5" rx="2.5"/>
        <rect x="184" y="38" width="30" height="6" rx="3"/>
        <rect x="184" y="50" width="20" height="5" rx="2.5"/>
      </clipPath>
    </defs>
    <g class="breathe" style="transform-origin:120px 48px">
      <g fill="none" stroke="var(--stroke)" stroke-width="1" stroke-linecap="round">
        <path class="wire" style="--i:0" pathLength="100" d="M74,48 H166"/>
      </g>
      <g class="dock" style="--i:0;--dx:-16px;--dy:0">
        <rect x="14" y="22" width="60" height="52" rx="11"
              fill="var(--app-bg)" stroke="var(--stroke)" stroke-width="1"/>
        <rect class="skeleton" x="26" y="38" width="30" height="6" rx="3" fill="var(--skeleton)"/>
        <rect class="skeleton" x="26" y="50" width="20" height="5" rx="2.5" fill="var(--skeleton-dim)"/>
      </g>
      <g class="dock" style="--i:1;--dx:16px;--dy:0">
        <rect x="166" y="22" width="60" height="52" rx="11"
              fill="var(--app-bg)" stroke="var(--stroke)" stroke-width="1"/>
        <rect class="skeleton" x="184" y="38" width="30" height="6" rx="3" fill="var(--skeleton)"/>
        <rect class="skeleton" x="184" y="50" width="20" height="5" rx="2.5" fill="var(--skeleton-dim)"/>
      </g>
      <g class="part" style="--i:2">
        <circle cx="120" cy="48" r="11" fill="var(--app-bg)"
                stroke="var(--stroke)" stroke-width="1"/>
        <circle cx="120" cy="48" r="4" fill="var(--app-primary)"/>
      </g>
      <g clip-path="url(#sheenClip)">
        <rect class="sheen" x="0" y="0" width="120" height="96" fill="url(#sheenGrad)"/>
      </g>
    </g>
  </svg></div>
  <h1>Signing you in</h1>
  <p class="lede">Completing authentication with your identity provider.</p>
</div>
{{ template "footer" }}
</body>
</html>
