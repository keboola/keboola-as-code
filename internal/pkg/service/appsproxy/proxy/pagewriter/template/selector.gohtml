<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/_proxy/assets/favicon.ico">

    <title>Auth Selection</title>

    <link rel="stylesheet" href="/_proxy/assets/styles.css">
</head>
<body class="s-action">
<div class="shell">
{{ template "lockmark" }}
{{ if .App.Name }}  <p class="eyebrow">{{ .App.Name }}</p>
{{ end }}  <h1>Choose how to sign in</h1>
  <div class="card">
    {{ range .Providers }}
    <a href="{{ .URL }}" class="provider">{{ .Name }}</a>
    {{ end }}
  </div>
{{ template "appmeta" . }}
</div>
{{ template "footer" }}
</body>
</html>
