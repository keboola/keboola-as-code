<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/_proxy/assets/favicon.ico">

    <title>Starting</title>
    <noscript>
        <meta http-equiv="refresh" content="{{.MetaRefreshSeconds}}">
    </noscript>
    <script>
        (function () {
            // Escalating copy. A cold start can run far longer than "a few moments",
            // and a page that says the same thing at second 90 as at second 3 reads
            // as stuck — perpetual motion says something is happening, not that this
            // is progressing. Wall clock rather than a tick count, so a backgrounded
            // tab (where setInterval is throttled) still escalates on real time.
            var startedAt = Date.now();
            var stage = 0;
            var lede = null;
            var stages = [
                {
                    after: 15,
                    text: "Still starting. This app hasn't run for a while, so it is being built from cold."
                },
                {
                    after: 45,
                    text: "This is taking longer than usual. It should still finish — if it doesn't, the app and project IDs below will help support."
                }
            ];

            setInterval(function () {
                // Cached on first use rather than resolved up front: this script runs
                // in <head>, so the element does not exist yet when it is evaluated.
                lede = lede || document.getElementById('lede');
                var elapsed = (Date.now() - startedAt) / 1000;
                while (lede && stage < stages.length && elapsed >= stages[stage].after) {
                    lede.textContent = stages[stage].text;
                    stage++;
                }

                fetch(window.location.href).then(function (response) {
                    // Refresh the page, if the app is started
                    if (response.status !== 503) {
                        window.location.reload();
                    }
                })
            }, {{.JSRefreshMilliseconds}})
        })();
    </script>

    <link rel="stylesheet" href="/_proxy/assets/styles.css">
</head>
<body class="s-working">
<div class="shell">
<div class="mark"><svg viewBox="14 31 452 188" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="sheenGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0"  stop-color="var(--sheen)" stop-opacity="0"/>
        <stop offset=".5" stop-color="var(--sheen)" stop-opacity="1"/>
        <stop offset="1"  stop-color="var(--sheen)" stop-opacity="0"/>
      </linearGradient>
      <clipPath id="sheenClip">
          <rect x="172" y="66" width="64" height="8" rx="4"/>
          <rect x="146" y="109" width="120" height="78" rx="8"/>
          <rect x="278" y="109" width="56" height="36" rx="8"/>
          <rect x="278" y="151" width="56" height="36" rx="8"/>
          <rect x="40" y="72" width="40" height="6" rx="3"/>
          <rect x="40" y="84" width="26" height="5" rx="2.5"/>
          <rect x="48" y="160" width="8" height="16" rx="3"/>
          <rect x="60" y="152" width="8" height="24" rx="3"/>
          <rect x="72" y="146" width="8" height="30" rx="3"/>
          <rect x="400" y="100" width="40" height="6" rx="3"/>
          <rect x="400" y="112" width="28" height="5" rx="2.5"/>
          <rect x="400" y="124" width="34" height="5" rx="2.5"/>
          <rect x="392" y="172" width="32" height="6" rx="3"/>
          <rect x="392" y="184" width="22" height="5" rx="2.5"/>
      </clipPath>
    </defs>
    <g class="breathe">
      <g fill="none" stroke="var(--stroke)" stroke-width="1" stroke-linecap="round">
        <path class="wire" style="--i:0" pathLength="100" d="M100,83 H128"/>
        <path class="wire" style="--i:1" pathLength="100" d="M100,161 H128"/>
        <path class="wire" style="--i:2" pathLength="100" d="M352,111 H388"/>
          <path class="wire" style="--i:3" pathLength="100" d="M352,179 H380"/>
      </g>
        <g class="dock" style="--i:0;--dx:-26px;--dy:-10px">
          <rect x="28" y="58" width="72" height="50" rx="11"
                fill="var(--app-bg)" stroke="var(--stroke)" stroke-width="1"/>
          <rect class="skeleton" x="40" y="72" width="40" height="6" rx="3" fill="var(--skeleton)"/>
          <rect class="skeleton" x="40" y="84" width="26" height="5" rx="2.5" fill="var(--skeleton-dim)"/>
        </g>
        <g class="dock" style="--i:1;--dx:-24px;--dy:14px">
          <rect x="36" y="138" width="64" height="46" rx="11"
                fill="var(--app-bg)" stroke="var(--stroke)" stroke-width="1"/>
          <rect class="skeleton" x="48" y="160" width="8" height="16" rx="3" fill="var(--skeleton)"/>
          <rect class="skeleton" x="60" y="152" width="8" height="24" rx="3" fill="var(--skeleton)"/>
          <rect class="skeleton" x="72" y="146" width="8" height="30" rx="3" fill="var(--skeleton)"/>
        </g>
        <g class="dock" style="--i:2;--dx:26px;--dy:-12px">
          <rect x="388" y="84" width="64" height="54" rx="11"
                fill="var(--app-bg)" stroke="var(--stroke)" stroke-width="1"/>
          <rect class="skeleton" x="400" y="100" width="40" height="6" rx="3" fill="var(--skeleton)"/>
          <rect class="skeleton" x="400" y="112" width="28" height="5" rx="2.5" fill="var(--skeleton-dim)"/>
          <rect class="skeleton" x="400" y="124" width="34" height="5" rx="2.5" fill="var(--skeleton-dim)"/>
        </g>
        <g class="dock" style="--i:3;--dx:24px;--dy:16px">
          <rect x="380" y="158" width="56" height="42" rx="11"
                fill="var(--app-bg)" stroke="var(--stroke)" stroke-width="1"/>
          <rect class="skeleton" x="392" y="172" width="32" height="6" rx="3" fill="var(--skeleton)"/>
          <rect class="skeleton" x="392" y="184" width="22" height="5" rx="2.5" fill="var(--skeleton-dim)"/>
        </g>
      <g class="frame">
        <rect x="128" y="45" width="224" height="160" rx="14"
              fill="var(--app-bg)" stroke="var(--stroke)" stroke-width="1"/>
      </g>
      <!-- Hollow shell + a single idle bar. Only ever visible in .s-rest, where
           the solid frame crossfades into it as the modules withdraw. The lone
           bar keeps the empty shell from reading as a broken placeholder, and
           stays in the same vocabulary as the content blocks.
           Nested groups so the once-only crossfade and the perpetual idle
           breathing never fight over the same property. -->
      <g class="rest-shell">
        <g class="frame-hollow">
          <g class="shell-idle">
            <rect x="128" y="45" width="224" height="160" rx="14"
                  fill="none" stroke="var(--ink-4)" stroke-width="1"
                  stroke-dasharray="5 6" stroke-linecap="round"/>
          </g>
        </g>
        <g class="dormant">
          <g class="bar-idle">
            <rect x="226" y="122" width="28" height="5" rx="2.5" fill="var(--ink-4)"/>
          </g>
        </g>
      </g>
      <g class="part" style="--i:0">
        <rect class="accent" x="146" y="63" width="18" height="18" rx="6"
              fill="var(--app-primary)"/>
      </g>
      <g class="part" style="--i:1"><rect class="skeleton" x="172" y="66" width="64" height="8" rx="4" fill="var(--skeleton)"/></g>
      <g class="part" style="--i:2">
        <path d="M128,95 H352" stroke="var(--hairline)" stroke-width="1"/>
      </g>
      <g class="part" style="--i:3"><rect class="skeleton" x="146" y="109" width="120" height="78" rx="8" fill="var(--skeleton)"/></g>
      <g class="part" style="--i:4"><rect class="skeleton" x="278" y="109" width="56" height="36" rx="8" fill="var(--skeleton)"/></g>
      <g class="part" style="--i:5"><rect class="skeleton" x="278" y="151" width="56" height="36" rx="8" fill="var(--skeleton)"/></g>
      <g clip-path="url(#sheenClip)">
        <rect class="sheen" x="0" y="0" width="190" height="250" fill="url(#sheenGrad)"/>
      </g>
    </g>
  </svg></div>
{{ if .App.Name }}  <h1>Starting <span class="accent">{{ .App.Name }}</span></h1>
{{ else }}  <h1>Starting your application</h1>
{{ end }}  <!-- aria-live so the escalation is spoken, not only shown: a screen reader
       user waiting on a slow cold start is exactly who needs to hear it. -->
  <p class="lede" id="lede" aria-live="polite">Your application is being provisioned. This usually
     takes a few moments &mdash; longer if it hasn't run recently.</p>
{{ template "appmeta" . }}
</div>
{{ template "footer" }}
</body>
</html>
